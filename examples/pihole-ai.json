{
  "format": "json",
  "pihole_ai_version": "0.5.0rc1",
  "schema_version": 1,
  "secure": false,
  "settings": [
    {
      "key": "events_db",
      "value": "/var/lib/pihole-ai/events.db"
    },
    {
      "key": "log_file",
      "value": "/var/log/pihole-ai/pihole-ai.log"
    },
    {
      "key": "alert_log",
      "value": "/var/log/pihole-ai/alerts.log"
    },
    {
      "key": "pihole_db",
      "value": "/etc/pihole/pihole-FTL.db"
    },
    {
