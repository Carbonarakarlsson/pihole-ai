      "value": "llama3.2:1b"
    },
    {
      "key": "intel_auto_update_enabled",
      "value": false
    },
    {
      "key": "dashboard_host",
      "value": "0.0.0.0"
    },
    {
      "key": "dashboard_port",
      "value": 8080
    },
    {
      "key": "dashboard_auth_enabled",
      "value": true
    },
    {
      "key": "dashboard_username",
      "value": "admin"
    },
    {
      "key": "log_level",
      "value": "INFO"
    }
  ]
