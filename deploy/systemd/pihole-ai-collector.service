[Unit]
Description=PiHole-AI Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pihole-ai
EnvironmentFile=/opt/pihole-ai/.env
ExecStart=/opt/pihole-ai/.venv/bin/pihole-ai collector
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
